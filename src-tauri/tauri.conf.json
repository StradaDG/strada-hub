{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strada Hub",
  "version": "0.14.2",
  "identifier": "com.strada.hub",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Strada Hub",
        "width": 340,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnBottom": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}